config = {
    xtermjs: "{{cookiecutter.xtermjs}}",
    _sdl2: "canvas",
    user_canvas: 0,
    user_canvas_managed: 1,
    gui_divider: 1,
    ume_block: 0,
    can_close: 0,
    archive: "{{cookiecutter.archive}}",
    gui_debug: 0,
    cdn: "{{cookiecutter.cdn}}",
    autorun: {{cookiecutter.autorun}},
    PYBUILD: "{{cookiecutter.PYBUILD}}",
    fb_ar: 390 / 844,
    fb_width: "{{cookiecutter.width}}",
    fb_height: "{{cookiecutter.height}}"
};

function show_infobox() {
    document.getElementById("infobox").style.display = "block";
}
function atualizar_resolucao() {
    const canvas = document.getElementById("canvas");
    const escala = Math.min(window.innerWidth / 390, window.innerHeight / 844);
    const largura = Math.max(1, Math.round(390 * escala));
    const altura = Math.max(1, Math.round(844 * escala));
    const densidade = Math.max(1, window.devicePixelRatio || 1);
    canvas.style.width = largura + "px";
    canvas.style.height = altura + "px";
    // O Pygame cria o canvas com estes pixels; o CSS controla só o tamanho visível.
    window.cognit_resolucao = [Math.round(largura * densidade), Math.round(altura * densidade)];
}
window.addEventListener("resize", atualizar_resolucao);
function cognit_pronto() {
    // O jogo só retira o aviso depois de desenhar seu primeiro quadro.
    document.getElementById("infobox").style.display = "none";
    document.getElementById("transfer").hidden = true;
}
function cognit_falhou() {
    const aviso = document.getElementById("infobox");
    aviso.textContent = "Não foi possível carregar o jogo. Verifique sua conexão e tente novamente.";
    const botao = document.createElement("button");
    botao.textContent = "Tentar novamente";
    botao.onclick = () => location.reload();
    aviso.appendChild(botao);
    aviso.style.display = "block";
    document.getElementById("transfer").hidden = true;
}
window.addEventListener("error", (evento) => {
    if (evento.target.id === "site") cognit_falhou();
}, true);
async function custom_onload() {
    atualizar_resolucao();
    show_infobox();
}
function custom_prerun() {}
function custom_postrun() {}
function info_inline(data) { document.getElementById("info").textContent = data; }
globalThis.__canvas_resized = () => {};
</script>
