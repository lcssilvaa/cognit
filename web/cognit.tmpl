<script>
// END BLOCK
config = {
    xtermjs: "{{cookiecutter.xtermjs}}",
    _sdl2: "canvas",
    user_canvas: 0,
    user_canvas_managed: 1,
    gui_divider: 1,
    ume_block: 0,
    can_close: 0,
    archive: "{{cookiecutter.archive}}",
    gui_debug: 0,
    cdn: "{{cookiecutter.cdn}}",
    autorun: {{cookiecutter.autorun}},
    PYBUILD: "{{cookiecutter.PYBUILD}}",
    fb_ar: 390 / 844,
    fb_width: "{{cookiecutter.width}}",
    fb_height: "{{cookiecutter.height}}"
};

function show_infobox() {
    document.getElementById("infobox").style.display = "block";
}
function atualizar_resolucao() {
    const canvas = document.getElementById("canvas");
    if (!canvas) return;
    const viewport = window.visualViewport;
    const disponivel = [
        Math.min(document.documentElement.clientWidth, viewport?.width || window.innerWidth),
        Math.min(document.documentElement.clientHeight, viewport?.height || window.innerHeight)
    ];
    const celular = window.matchMedia("(pointer: coarse), (max-width: 600px)").matches;
    const escala = Math.min(disponivel[0] / 390, disponivel[1] / 844);
    const largura = Math.max(1, Math.round(celular ? disponivel[0] : 390 * escala));
    const altura = Math.max(1, Math.round(celular ? disponivel[1] : 844 * escala));
    // Limitar a 2x evita renderizar milhões de pixels extras a cada quadro no celular.
    const densidade = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
    canvas.style.width = largura + "px";
    canvas.style.height = altura + "px";
    canvas.style.margin = celular ? "0" : "auto";
    // O Pygame cria o canvas com estes pixels; o CSS controla só o tamanho visível.
    window.cognit_resolucao = [Math.round(largura * densidade), Math.round(altura * densidade)];
}
window.addEventListener("resize", atualizar_resolucao);
window.visualViewport?.addEventListener("resize", atualizar_resolucao);
document.addEventListener("fullscreenchange", atualizar_resolucao);
function cognit_pronto() {
    // O jogo só retira o aviso depois de desenhar seu primeiro quadro.
    document.getElementById("infobox").style.display = "none";
    document.getElementById("transfer").hidden = true;
    document.getElementById("tela-cheia").hidden = !document.fullscreenEnabled;
}
function cognit_falhou() {
    const aviso = document.getElementById("infobox");
    aviso.textContent = "Não foi possível carregar o jogo. Verifique sua conexão e tente novamente.";
    const botao = document.createElement("button");
    botao.textContent = "Tentar novamente";
    botao.onclick = () => location.reload();
    aviso.appendChild(botao);
    aviso.style.display = "block";
    document.getElementById("transfer").hidden = true;
}
window.addEventListener("error", (evento) => {
    if (evento.target.id === "site") cognit_falhou();
}, true);
async function custom_onload() {
    atualizar_resolucao();
    show_infobox();
}
function custom_prerun() {}
function custom_postrun() {}
// Ponte pequena entre o Python/WebAssembly e o HTTP do servidor de salas.
window.cognit_servidor = new URLSearchParams(location.search).get("servidor")
    || window.cognit_config?.servidor
    || window.cognit_config?.servidoresPorOrigem?.[location.origin]
    || location.origin;
// O áudio nativo continua estável mesmo quando um quadro do Pygame demora.
const musicaCognit = new Audio("assets/musica_fundo.ogg");
musicaCognit.loop = true;
musicaCognit.preload = "auto";
let musicaHabilitada = false;
let musicaLiberada = false;
let inicioMusica = null;
let erroMusica = null;
function cognit_audio_iniciar() {
    if (!musicaHabilitada || !musicaLiberada || document.hidden || inicioMusica || !musicaCognit.paused) return;
    inicioMusica = musicaCognit.play()
        .then(() => { erroMusica = null; })
        .catch(erro => {
            if (erro.name !== "NotAllowedError" && erro.name !== "AbortError") {
                erroMusica = "Não foi possível reproduzir a música.";
            }
        })
        .finally(() => { inicioMusica = null; });
}
function cognit_audio_configurar(habilitada, volume) {
    musicaHabilitada = Boolean(habilitada);
    musicaCognit.volume = Math.max(0, Math.min(1, Number(volume)));
    if (musicaHabilitada) cognit_audio_iniciar();
    else musicaCognit.pause();
}
function cognit_audio_estado() {
    return JSON.stringify({
        carregada: musicaCognit.readyState >= 2,
        tocando: !musicaCognit.paused && !musicaCognit.ended,
        pausada: musicaCognit.paused && musicaCognit.currentTime > 0,
        erro: erroMusica
    });
}
function cognit_audio_encerrar() {
    musicaHabilitada = false;
    musicaCognit.pause();
    musicaCognit.currentTime = 0;
}
function liberar_audio(evento) {
    if (!evento.isTrusted) return;
    musicaLiberada = true;
    cognit_audio_iniciar();
}
window.addEventListener("pointerdown", liberar_audio, {capture: true, passive: true});
window.addEventListener("keydown", liberar_audio, {capture: true});
document.addEventListener("visibilitychange", () => {
    if (document.hidden) musicaCognit.pause();
    else cognit_audio_iniciar();
});
window.addEventListener("pagehide", () => musicaCognit.pause());
window.addEventListener("pageshow", cognit_audio_iniciar);
async function cognit_tela_cheia() {
    const botao = document.getElementById("tela-cheia");
    try {
        if (document.fullscreenElement) await document.exitFullscreen();
        else await document.documentElement.requestFullscreen();
    } catch (erro) {
        botao.title = "O navegador não permitiu abrir em tela cheia.";
    }
}
document.addEventListener("fullscreenchange", () => {
    const botao = document.getElementById("tela-cheia");
    const ativa = Boolean(document.fullscreenElement);
    botao.setAttribute("aria-pressed", String(ativa));
    botao.setAttribute("aria-label", ativa ? "Sair da tela cheia" : "Abrir em tela cheia");
    botao.title = ativa ? "Sair da tela cheia" : "Abrir em tela cheia";
});
const pedidosCognit = new Map();
function cognit_json_ascii(valor) {
    // A ponte do Pygbag pode interpretar UTF-8 como Latin-1. Os escapes JSON
    // preservam apelidos, dicas e explicações, inclusive emojis e acentos.
    return JSON.stringify(valor).replace(/[\u007f-\uffff]/g,
        caractere => "\\u" + caractere.charCodeAt(0).toString(16).padStart(4, "0"));
}
function cognit_requisitar(id, url, corpo, espera = 6) {
    const pedido = {controle: new AbortController(), resultado: ""};
    pedidosCognit.set(id, pedido);
    const timeout = setTimeout(() => pedido.controle.abort(), espera * 1000);
    fetch(url, {
        method: "POST", headers: {"Content-Type": "application/json"},
        body: corpo, signal: pedido.controle.signal, credentials: "omit"
    }).then(resposta => resposta.json())
      .then(dados => pedido.resultado = cognit_json_ascii(dados))
      .catch(() => pedido.resultado = cognit_json_ascii({erro: "Não foi possível conectar. Tente novamente em instantes."}))
      .finally(() => clearTimeout(timeout));
}
function cognit_resultado(id) { return pedidosCognit.get(id)?.resultado || ""; }
function cognit_cancelar(id) {
    pedidosCognit.get(id)?.controle.abort();
    pedidosCognit.delete(id);
}
function info_inline(data) { document.getElementById("info").textContent = data; }
globalThis.__canvas_resized = () => {};
</script>
