import asyncio
import os
import platform
from pathlib import Path


async def custom_site():
    import embed
    from aio.pep0723 import Config

    # O Pygbag presume que localhost possui um proxy para /cdn/.
    # O servidor do jogo não possui esse proxy, então usamos o CDN real também aqui.
    os.environ["PYGPI"] = "https://pygame-web.github.io/cdn/"
    for repositorio in Config.pkg_repolist:
        repositorio["-CDN-"] = os.environ["PYGPI"]

    def relatar_erro(loop, contexto):
        erro = contexto.get("exception") or contexto.get("message")
        print(f"Falha ao executar o jogo: {erro}")
        platform.window.cognit_falhou()

    asyncio.get_running_loop().set_exception_handler(relatar_erro)
    platform.window.canvas.style.visibility = "visible"
    bundle = "{{cookiecutter.archive}}"
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    if platform.window.location.host.find('.itch.zone') > 0:
        import zipfile
        async with platform.fopen("{{cookiecutter.archive}}.apk", "rb") as archive:
            with zipfile.ZipFile(archive) as arquivo:
                arquivo.extractall(appdir.as_posix())
    else:
        import tarfile
        async with platform.fopen("{{cookiecutter.archive}}.tar.gz", "rb") as archive:
            with tarfile.open(fileobj=archive, mode="r:gz") as arquivo:
                arquivo.extractall(path=appdir.as_posix(), filter='tar')

    platform.run_main(PyConfig, loaderhome=appdir / "assets", loadermain=None)
    while embed.counter() < 0:
        await asyncio.sleep(.1)

    main = appdir / "assets" / "main.py"
    await TopLevel_async_handler.start_toplevel(platform.shell, console=False)
    __import__(__name__).__file__ = main

    def ui_callback(pkg):
        platform.window.infobox.innerText = "Preparando o jogo…"

    try:
        await shell.source(main, callback=ui_callback)
    except Exception:
        import traceback
        traceback.print_exc()
        platform.window.cognit_falhou()
        return
    platform.window.config.gui_divider = 1
    platform.window.window_resize()


asyncio.run(custom_site())

