    #tela-cheia:focus-visible { outline: 2px solid #1e5fa8; outline-offset: 2px; }
    #tela-cheia svg { width: 19px; height: 19px; }
    #crt, #pyconsole, #dlg, #html { display: none !important; }
</style>
